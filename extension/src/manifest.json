{
  "manifest_version": 3,
  "name": "WorkStream Wallet (pilot)",
  "short_name": "WorkStream",
  "description": "Pilot browser wallet for WorkStream work orders (#148).",
  "version": "0.0.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["storage", "windows", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WorkStream Wallet"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/inpage.js", "approval.html", "approval.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
